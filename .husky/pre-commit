#!/usr/bin/env sh

# pre-commit: 代码提交前门禁
# 执行 prettier 格式化 + eslint + tsc 类型检查
# 跳过: git commit --no-verify

set -e

# 1. Prettier 格式化（仅暂存文件）
echo "[pre-commit] Running prettier on staged files..."
npx pretty-quick --staged --pattern '**/*.ts' 2>/dev/null || true

# 2. ESLint 检查（口径与 CI 的 `npm run lint` 一致：只检 Src/ 下的暂存 TS 文件）
#    不吞错 —— 错误必须挡住提交，否则问题只会到 GitHub CI 才暴露。
#    Src 之外（Benchmarks/Client/Tests）不在 .eslintrc 的 parserOptions.project 内，
#    直接送进 eslint 会报 "file was not found in any of the provided project(s)"。
echo "[pre-commit] Running ESLint on staged Src files..."
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACM | grep '^Src/.*\.ts$' | tr '\n' ' ')
if [ -n "$STAGED_SRC" ]; then
  npx eslint --ext .ts $STAGED_SRC
fi

# 3. TypeScript 类型检查（Src + electron 两组配置）
echo "[pre-commit] Running TypeScript type check..."
npx tsc --noEmit
npx tsc --noEmit -p tsconfig.electron.json

echo "[pre-commit] All checks passed."
