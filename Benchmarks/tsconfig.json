{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./.tsbuild",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["runner/**/*.ts"],
  "exclude": ["reports", "datasets", ".tsbuild"]
}
