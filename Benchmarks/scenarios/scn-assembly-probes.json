    "assertProbesMustPass": [
      "TOOL-FORBIDDEN-REGISTER",
      "AGENT-ILLEGAL-TRANSITION",
      "MEM-CONSOLIDATE-GATE",
      "AGENT-ID-MONOTONIC",
      "SUP-HUMANGATE-PENDING",
