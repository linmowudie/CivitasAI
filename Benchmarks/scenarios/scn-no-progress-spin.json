{
  "id": "scn-no-progress-spin",
  "title": "收敛：持续调用工具但无实质进展，必须如实终止而不是挂起",
  "tags": ["convergence", "diagnosis"],
  "matrixCells": ["AG-ENV-DEADLOCK"],
  "task": {
    "description": "把结果逐步落库；但每一轮拿到的都是无关回显，任务实际上没有推进",
    "goal": "把结果落库并汇报"
  },
  "agentRole": "worker",
  "loop": { "maxIterations": 4, "tokenBudget": 100000, "timeoutMs": 30000, "stream": false },
  "tools": [{ "name": "bench.echo", "behavior": "ok" }],
  "model": {
    "script": [
      { "kind": "tool_calls", "calls": [{ "name": "bench.echo", "arguments": { "text": "attempt-1" } }] },
      { "kind": "tool_calls", "calls": [{ "name": "bench.echo", "arguments": { "text": "attempt-2" } }] },
      { "kind": "tool_calls", "calls": [{ "name": "bench.echo", "arguments": { "text": "attempt-3" } }] },
      { "kind": "tool_calls", "calls": [{ "name": "bench.echo", "arguments": { "text": "attempt-4" } }] },
      { "kind": "tool_calls", "calls": [{ "name": "bench.echo", "arguments": { "text": "attempt-5" } }] }
    ],
    "defaultReply": "任务完成。"
  },
  "expect": {
    "exitReasonOneOf": ["no_progress", "max_iterations"],
    "forbidDiagnoses": ["false_success"]
  }
}
