# ===== 跨平台换行符策略（skill documentation.md §05：统一 LF）=====
* text=auto eol=lf

# ===== 明确文本类型 =====
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.cjs  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.sh   text eol=lf

# ===== Windows 脚本保留 CRLF =====
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# ===== 二进制文件（禁止 diff / 换行转换）=====
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.db   binary
*.sqlite binary
*.node binary
*.exe  binary
*.zip  binary
*.gz   binary
*.tgz  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# ===== 语言属性（用于 GitHub linguist / diff）=====
*.ts   linguist-language=TypeScript
*.tsx  linguist-language=TypeScript
