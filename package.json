{
  "name": "civitas-ai",
  "version": "0.1.0",
  "description": "Civitas-AI — 社会驱动型自治智能体系统",
  "type": "module",
  "main": "dist/main/electron/main.cjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run typecheck:electron",
    "build:client": "cd Client && npx vite build && node ../Scripts/verifyClientDist.cjs",
    "build:server": "node Scripts/build.cjs",
    "build:all": "npm run build:server && npm run build:client",
    "start": "tsx Src/main.ts",
    "start:electron": "electron .",
    "dev": "concurrently -n BE,VITE -c blue,green \"tsx watch Src/main.ts\" \"cd Client && npx vite\"",
    "dev:server": "tsx Src/main.ts",
    "dev:electron": "npm run build:server && concurrently -n VITE,ELN -c green,magenta \"cd Client && npx vite\" \"wait-on http://localhost:5173 && electron .\"",
    "gen:event-types": "tsx Scripts/genEventTypes.ts",
    "server:dev": "cd Server && npm run dev",
    "server:migrate": "cd Server && npm run migrate",
    "server:migrate:status": "cd Server && npm run migrate:status",
    "server:test": "cd Server && npm test",
    "server:db:up": "cd Server && npm run db:up",
    "server:db:down": "cd Server && npm run db:down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint Src/ --ext .ts",
    "lint:fix": "eslint Src/ --ext .ts --fix",
    "layer-check": "eslint Src/ --ext .ts --rule '{\"import/no-restricted-paths\": [\"error\", {\"zones\": []}]}'",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "electron:dev": "npm run dev:electron",
    "electron:build": "npm run build:all && electron-builder --win portable",
    "electron:build:dir": "npm run build:all && electron-builder --win dir",
    "package": "node Scripts/package.cjs",
    "package:nsis": "node Scripts/package.cjs --nsis",
    "package:portable": "node Scripts/package.cjs --portable",
    "package:dir": "node Scripts/package.cjs --dir",
    "package:check": "node Scripts/package.cjs --check",
    "package:signed": "node Scripts/packageSigned.cjs",
    "sign:setup": "pwsh -NoProfile -ExecutionPolicy Bypass -File Scripts/setupSelfSignedCert.ps1",
    "sign:verify": "pwsh -NoProfile -ExecutionPolicy Bypass -File Scripts/verifySign.ps1",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "package:probe": "node Scripts/probePackagedBackend.cjs"
  },
  "build": {
    "appId": "com.civitasai.app",
    "productName": "CivitasAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "Configs/**/*",
      "Prompts/**/*",
      "Skills/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/*/{test,tests,example,examples,docs,doc}/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "Configs",
        "to": "app/Configs",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "Prompts",
        "to": "app/Prompts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "Skills",
        "to": "app/Skills",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "CivitasAI",
      "shortcutName": "Civitas AI",
      "uninstallDisplayName": "CivitasAI（智体城邦）",
      "artifactName": "CivitasAI-Setup-${version}.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "warningsAsErrors": false,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "CivitasAI-Portable.exe"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**/*"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@electron/rebuild": "^4.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.4.0",
    "pretty-quick": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "wait-on": "^9.1.0",
    "zustand": "^5.0.15"
  }
}
