# Civitas-AI 服务端配置示例
# 复制为 .env 后按需修改；服务端启动时会读取本文件（不依赖 dotenv）

# ── 运行 ───────────────────────────────────────────────
NODE_ENV=development
# 监听地址与端口（0.0.0.0 才能被同网段/容器访问）
HOST=127.0.0.1
PORT=8787

# ── 数据库（必填）─────────────────────────────────────
# 与 docker-compose.yml 的默认值一致
DATABASE_URL=postgres://civitas:civitas@127.0.0.1:5432/civitas_server
# 连接池
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# ── 鉴权（生产必填，≥32 字符）──────────────────────────
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# 是否允许同一刷新令牌被重复使用（false = 检测到重用即吊销全部会话，推荐）
ALLOW_REFRESH_REUSE=false

# ── 验证码登录（安全审计后加固：哈希存储 + CSPRNG + 失败锁定 + 配额）──
# 验证码有效期（秒）
CODE_TTL_SEC=300
# 同一邮箱在窗口内最多请求几次（防刷码/信箱轰炸）
CODE_MAX_PER_WINDOW=3
# 配额窗口（秒）
CODE_WINDOW_SEC=600
# 两次发送的最小间隔（秒）；0 = 不做冷却（仅开发/自测）
CODE_RESEND_COOLDOWN_SEC=60
# 单个验证码允许的最大失败次数（超过即作废，防 6 位码爆破）
CODE_MAX_ATTEMPTS=5
# 是否在响应里回传验证码（**仅开发**；生产开启会被拒绝启动）
ALLOW_DEV_CODE=false

# ── 邮件通道（生产必填）────────────────────────────────
# 自托管场景用 webhook 对接任意发信服务（POST JSON: {from,to,subject,text}）
# 未配置时：开发环境打印到日志；**生产环境会拒绝启动**（否则用户收不到验证码无法登录）
MAIL_WEBHOOK_URL=
MAIL_FROM=Civitas-AI <no-reply@civitas.local>
MAIL_TIMEOUT_MS=10000

# ── 设备策略（换机/重装的可用性 vs 安全）──────────────
# off    不记录设备
# warn   记录并审计新设备，但允许登录（默认；换机/换网不再被锁死）
# strict 拒绝未登记设备（企业场景；配合「账号 → 登录设备」自助解绑）
DEVICE_BINDING_MODE=warn

# ── 限流（按 IP / 按用户）──────────────────────────────
# 计数存储：
#   memory   = 进程内滑动窗口（单实例；开发/测试默认）
#   postgres = 存入 PostgreSQL 固定窗口，多实例共享同一份计数（生产默认，SV-003）
# 何时必须用 postgres：**服务端多实例/多副本部署** —— 否则各实例各算一份，
# 实际阈值 = 配置值 × 实例数（暴力破解防护被稀释）。
RATE_LIMIT_STORE=memory
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=240
RATE_LIMIT_WRITE_PER_MIN=120

# ── 请求与数据上限 ─────────────────────────────────────
BODY_LIMIT_BYTES=1048576
MAX_SETTINGS_BYTES=262144
MAX_MEMORIES_PER_BULK=1000
MAX_STATS_EVENTS_PER_BATCH=500

# ── CORS（浏览器客户端才需要；Electron 直连可留空）──────
CORS_ORIGINS=

# ── 日志 ───────────────────────────────────────────────
LOG_LEVEL=info

# ── 运行库时区（影响统计分日）──────────────────────────
STATS_TIMEZONE=Asia/Shanghai
